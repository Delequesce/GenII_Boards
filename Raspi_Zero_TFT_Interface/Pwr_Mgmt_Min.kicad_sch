				(size 1.27 1.27)
			)
		)
		(uuid "ec7ee20a-add1-48ea-86f4-b73e58855163")
	)
	(text "For longevity of battery, we\nmay want to limit peak voltage \nof the battery. "
		(exclude_from_sim no)
		(at 80.264 26.67 0)
		(effects
