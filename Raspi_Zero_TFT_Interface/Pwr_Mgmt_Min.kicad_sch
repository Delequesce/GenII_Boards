	(text "Main Power Switch"
		(exclude_from_sim no)
		(at 119.126 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4ad8d461-a2d1-47df-a55c-ed9e7f02a5da")
	)
	(text "Use Cases:\n1) Switch Off, charger plugged in: G = 0->5V, S = 0->4.3V, P-FET Off\n2) Charger stays In, Switch flipped ON: G = 5V, S = 4.3V, P-FET Off\n3) Charger Removed, switch stays on: G = 5->0V, S = 4.3, P-FET turns on, S->3.7V\n4) Switch Turned Off, charger stays removed: G = 0V, S = 3.7->0V, \nP-FET turns off after a few time constants.  \n"
		(exclude_from_sim no)
		(at 15.24 64.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "68b5183f-38c3-44d0-bf59-42a528982f72")
	)
	(text "Same LDO used on Nucleo Board"
		(exclude_from_sim no)
		(at 138.684 40.386 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7e607670-327b-4c32-9351-4f9c2cffcc76")
	)
	(text "Main Power Light"
		(exclude_from_sim no)
		(at 165.1 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b7b3e771-3760-4f80-82fa-16cb9de9c413")
	)
	(text "Must turn on main power switch to power \non the heater, MCU, and analog front end.  \nBattery Charging still works as long as \nUSB Source and battery are connected. "
		(exclude_from_sim no)
		(at 117.602 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cbabe22b-13dc-4560-92dc-6878acbf8a92")
	)
	(text "For longevity of battery, we\nmay want to limit peak voltage \nof the battery. "
		(exclude_from_sim no)
		(at 80.264 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fa64b933-2b6a-4b86-b605-89431b44758b")
	)
	(text "Charging Light"
		(exclude_from_sim no)
		(at 115.57 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fb0be89c-69c3-496f-951f-0354dd0b8ea3")
	)
	(text "- Rds_On should be very low \n  to avoid excess power drain \n  from battery\n- Continuous drain current must \n  go up to 1A"
		(exclude_from_sim no)
		(at 123.698 62.484 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fd21805c-9e66-4552-92f2-42a89e479ee6")
	)
