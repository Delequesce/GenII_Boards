	)
	(text "USB_VCC 1 and 2 should be monitored by MCU \nADC channels to determine how much current \nsource can supply. If too low, MCU should not\nallow certain functions and warn the user. "
		(exclude_from_sim no)
		(at 206.502 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "745b139c-8e95-4229-aa41-1cd1ec3d096e")
	)
	(text "Separate Connection Board\nfor tactile switch. Interfaces\nwith measurement board"
		(exclude_from_sim no)
		(at 87.376 90.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7ad8f73e-bdfd-4f57-aed6-2a269de73aaa")
	)
	(text "Raspberry Pi Zero 2W\nConnector. Right and\nleft sides are flipped\nfor bottom facing connector"
		(exclude_from_sim no)
		(at 161.544 24.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "87b5ace0-6472-45a9-a56f-23f0a4bafd57")
	)
	(text "PWR_CTRL is connected to open drain of MCU GPIO\nWhen driven low, transistor turns ON and power flows\nto Pi and Screen. When MCU is off or left floating, \nVgs = 0 and flow stops. \nPullup can be fairly weak"
		(exclude_from_sim no)
		(at 157.988 139.954 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "92dea47b-4a5b-4d05-b06b-2a8588e6b224")
	)
	(text "This sets dimming based on duty \ncycle of enable signal. \nFrequency should be below 2 kHz. "
		(exclude_from_sim no)
		(at 125.984 183.388 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
